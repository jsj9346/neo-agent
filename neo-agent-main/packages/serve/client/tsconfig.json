{
  // 브라우저 모듈의 타입 검사 — 정본은 `docs/WEB-UI.md` §9.3이고, 그 절이
  // *"타입 검사는 이 디렉터리의 별도 `tsconfig.json`이 진다"*로 이 파일을 못박았다.
  // 계약인 것은 파일 이름이 아니라 **이 디렉터리가 타입 검사 모집단 안에 든다**는 것 하나다.
  //
  // 루트 `tsconfig.json`이 이 디렉터리를 재지 않는 이유가 §9.3의 판정이다 — 설정을 가르지
  // 않고 `DOM`을 `tsconfig.base.json`에 더하면 DOM 전역이 `packages/*/src` 전체로 새어
  // **서버 코드가 브라우저 API를 쓰는 것을 타입이 안 막게 된다.** §2.2가 모듈 이름으로 세운
  // 경계를 전역 타입이 우회하는 경로이고, 설정을 가르는 것 자체가 그 판정의 절반이다.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // §9.3 — 브라우저가 빌드 없이 직접 로드하므로 소스가 `.js`이고, 그 `.js`에 타입 검사를
    // 거는 수단이 이 둘이다. 타입은 JSDoc으로 적고 프레임 정의는 `../src/protocol.ts`를
    // 그대로 들여오므로 §6의 유니온이 정의 하나에서 온다 — 판별자 소진 검사가 성립하는
    // 조건이 그것이다.
    "allowJs": true,
    "checkJs": true,

    // §9.3 — `DOM`이 열리는 자리는 여기 하나다.
    "lib": ["ES2024", "DOM"],

    // **경계는 양방향이다.** `tsconfig.base.json`의 `types: ["node"]`를 여기서 비운다 —
    // 그러지 않으면 DOM은 갈라 놓고 Node 전역(`process`·`Buffer`)은 브라우저 모듈에서
    // 그대로 보여, §9.3이 설정을 가른 이유의 절반만 서게 된다.
    //
    // 이 프로그램에는 `../src/protocol.ts`와 그것이 부르는 `@neo-agent/core`의 `.ts`가
    // 해석 경유로 함께 든다. 그 둘이 Node 내장을 안 쓰기 때문에 이 값이 성립하고,
    // **그것은 우연이 아니라 예산 게이트가 강제하는 성질이다**(`scripts/check-core-budget.mjs`의
    // `IO_MODULES` · `CORE-INTERFACE.md` §1). 서버 쪽 조립·전송 코드는 이 프로그램에
    // 도달하지 않는다 — 브라우저 모듈이 프레임 **타입**만 들여오기 때문이고, 그 배치가
    // §9.3의 *"정의 하나에서 온다"*이다.
    "types": [],

    // 산출물이 없다(§9.3 · `TECH-STACK.md` §2). 이 검사가 낳는 것은 종료 코드뿐이므로
    // 빌드 스텝을 두지 않기로 한 확정이 그대로 선다. (`tsconfig.base.json`이 이미 켜 두었고
    // 여기서 되풀이하는 것은 그 성질이 이 파일의 계약이기 때문이다.)
    "noEmit": true
  },
  // 서버 쪽 `.ts`는 여기 열거하지 않는다 — 임포트로만 들어와야 루트 검사와 이 검사의
  // 모집단이 갈린 채로 남는다.
  "include": ["**/*.js"]
}
