{
  "name": "neo-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/serve/client/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:budget": "node scripts/check-core-budget.mjs",
    "check:docs": "node scripts/check-doc-status.mjs",
    "check:citations": "node scripts/check-doc-citation.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:budget && pnpm check:docs && pnpm check:citations && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@neo-agent/cli": "workspace:*",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
