#!/bin/sh
# 스파이 `docker` — 호출을 관측만 하는 가짜 실행 파일.
#
# 쓰임: PATH 앞단에 이 디렉터리를 놓고 스위트를 돌려 "docker를 정말 안 부르는가"를
# **주장이 아니라 관측**으로 만든다. 2026-08-09 T-014가 1회성으로 만들어 쓰고 버린
# 방법을 레포에 상설화한 것이다 — 버렸기 때문에 다음 사람이 같은 것을 다시 만든다.
#
#   : > /tmp/spy.log         # 지우지 말고 **비운다** — 없는 파일은 wc가 에러를 내고,
#                            # 그러면 관측 도구의 결함과 "0건"이 구분되지 않는다
#   PATH="$PWD/scripts/spy-docker:$PATH" NEO_SPY_LOG=/tmp/spy.log pnpm test
#   wc -l < /tmp/spy.log     # 0이어야 한다
#
# **종료 코드가 0이 아닌 것이 설계다.** 0이면 "docker가 있고 정상"으로 오인돼 호출한
# 쪽이 다른 경로를 타고, 그러면 이 하네스는 관측 도구가 아니라 **동작을 바꾸는 개입**이
# 된다. 비영으로 두면 `probeDocker`의 계약("부재·권한 없음·무응답을 전부 판정으로
# 흡수")이 그대로 작동해 불가용 갈래로 떨어진다 — 즉 하네스가 있든 없든 스위트의
# 결과가 같아야 하고, 그 동일성 자체가 검증 조건이다.
#
# 이 파일은 게이트가 부르지 않는다. `pnpm check`가 PATH 조작에 의존하기 시작하면
# 게이트 자신의 재현성이 셸 구성에 종속되기 때문이다(2026-08-10 판정 D-1) —
# 강제는 `check-core-budget.mjs`의 정적 검사가 하고, 이쪽은 관측 수단으로만 남는다.

log="${NEO_SPY_LOG:-/tmp/neo-spy-docker.log}"
printf '%s pid=%s args=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" "$*" >>"$log"
echo "neo-agent spy docker: 호출을 기록만 하고 아무것도 실행하지 않았다 (로그: $log)" >&2
exit 1
